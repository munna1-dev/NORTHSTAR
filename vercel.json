{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/staff/:path*",
      "destination": "/api/management/auth/:path*"
    },
    {
      "source": "/api/health",
      "destination": "/api/management/system/health"
    },
    {
      "source": "/api/db-health",
      "destination": "/api/management/system/db-health"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/customer/:path*",
      "destination": "/api/customer"
    },
    {
      "source": "/api/management/:path*",
      "destination": "/api/management"
    },
    {
      "source": "/api/public/:path*",
      "destination": "/api/public"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm install --include=dev"
}
